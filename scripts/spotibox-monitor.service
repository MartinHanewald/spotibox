[Unit]
Description=Spotibox power/load monitor
# Start before the main player so we capture the display + audio wait periods
Before=spotibox.service
After=sysinit.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/spotibox

# Ensure the log directory is owned by admin before starting
ExecStartPre=/bin/bash -c 'mkdir -p /var/log/spotibox && chown admin:admin /var/log/spotibox'

ExecStart=/home/admin/.local/bin/uv run python scripts/monitor_power.py \
    --interval 0.25 \
    --output-dir /var/log/spotibox \
    --max-files 20

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
